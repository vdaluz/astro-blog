---
import type { BlogPostLike } from '../lib/types.ts';
import { t, formatDate, type Locale } from '../lib/i18n.ts';
import { postHref } from '../lib/post-href.ts';
import { heroImageWebp } from '../lib/hero-image.ts';
import ThumbnailLink from './internal/ThumbnailLink.astro';
import ReadLink from './internal/ReadLink.astro';

interface Props {
  post: BlogPostLike;
  /** Route prefix posts live under. Defaults to "/blog". */
  base?: string;
  /** Locale for date formatting and UI strings. Defaults to "en". */
  locale?: Locale;
  /** Override text for the category badge. Defaults to post.data.category. */
  categoryLabel?: string;
  /** Whether this site's canonical post URL ends in a trailing slash. Defaults to false. */
  trailingSlash?: boolean;
}

const {
  post,
  base = '/blog',
  locale = 'en',
  categoryLabel = post.data.category,
  trailingSlash = false,
} = Astro.props;
const href = postHref(base, post.id, trailingSlash);
const strings = t(locale);
const thumbnail = heroImageWebp(post.data.heroImage);
---

<article
  class="bg-surface rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300"
>
  {
    thumbnail && (
      <ThumbnailLink href={href} src={thumbnail} width="800" height="192" class="w-full h-48 object-cover" />
    )
  }
  <div class="p-8">
    <div
      class="inline-block px-3 py-1 bg-accent-soft text-accent rounded-full text-sm font-medium mb-4"
    >
      {categoryLabel}
    </div>
    <h2 class="text-2xl md:text-3xl font-bold text-fg mb-4 hover:text-accent transition-colors">
      <a href={href}>{post.data.title}</a>
    </h2>
    <p class="text-muted mb-6 leading-relaxed text-lg">{post.data.description}</p>
    <div class="flex items-center justify-between">
      <time datetime={post.data.pubDate.toISOString()} class="text-sm text-muted">
        {formatDate(post.data.pubDate, locale)}
      </time>
      <ReadLink
        href={href}
        label={strings.readMore}
        title={post.data.title}
        class="inline-flex items-center text-accent font-semibold hover:text-accent-strong transition-colors group"
        iconClass="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform duration-300"
      />
    </div>
  </div>
</article>
