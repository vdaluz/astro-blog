---
import { buildBlogPostingSchema, serializeForScriptTag } from '../lib/schema.ts';
import type { BlogPostLike } from '../lib/types.ts';
import type { Locale } from '../lib/i18n.ts';

interface Props {
  post: BlogPostLike;
  /** Origin only, e.g. "https://imperfectsystems.com". */
  siteUrl: string;
  /** Route prefix posts live under. Defaults to "/blog". */
  base?: string;
  /** @deprecated Use `base`. Removed in 2.0. Ignored when `base` is set. */
  basePath?: string;
  /** Site/brand name for JSON-LD publisher. Falls back to the post author. */
  publisherName?: string;
  /** Locale for the JSON-LD `inLanguage` field. Omitted if unset. */
  locale?: Locale;
  /** Whether this site's canonical post URL ends in a trailing slash. Defaults to false. */
  trailingSlash?: boolean;
  /** Fallback JSON-LD `image` (e.g. the post's OG card), used only when the post has no `heroImage`. */
  image?: string;
}

const { post, siteUrl, base, basePath, publisherName, locale, trailingSlash, image } = Astro.props;
const schema = buildBlogPostingSchema({
  post,
  siteUrl,
  base: base ?? basePath,
  publisherName,
  locale,
  trailingSlash,
  image,
});
---

{/* JSON-LD is valid in <body>; render this anywhere inside the post page. */}
<script type="application/ld+json" set:html={serializeForScriptTag(schema)} />
